{
  "name": "noir",
  "label": "Noir",
  "description": "Svart lerret, stor hvit sans-typografi, fargede grafer. Nøytralt og proft.",
  "tokens": {
    "bg": "#000000",
    "text": "#ffffff",
    "muted": "rgba(255, 255, 255, 0.6)",
    "faint": "rgba(255, 255, 255, 0.45)",
    "line": "rgba(255, 255, 255, 0.12)",
    "grid": "#242424",
    "sans": "\"Helvetica Neue\", Helvetica, Arial, sans-serif",
    "serif": "Georgia, \"Times New Roman\", Times, serif",
    "mono": "ui-monospace, \"SF Mono\", Menlo, monospace"
  },
  "palette": [
    "#6b8afd", "#e8e97a", "#f2683c", "#c9d96a", "#f4b8c7", "#7de2b8",
    "#f2994a", "#a8e6f0", "#a8a838", "#8b6bb0", "#d8d8d8", "#e04444"
  ],
  "images": ["bg-1.jpg", "bg-2.jpg", "bg-3.jpg"],
  "layouts": [
    {
      "key": "title",
      "label": "Tittelslide",
      "use": "Åpningsslide. Bruk alltid bakgrunnsbilde.",
      "fields": [
        { "key": "title", "kind": "text", "hint": "kort slagkraftig tittel, 3-7 ord", "required": true },
        { "key": "content", "kind": "text", "hint": "én undertekstlinje, f.eks. selskap og anledning" },
        { "key": "image", "kind": "image", "hint": "bakgrunnsbilde fra temaet", "required": true }
      ],
      "blocks": [
        { "kind": "bg", "field": "image" },
        {
          "kind": "group", "class": "centerBlock",
          "children": [
            { "kind": "text", "field": "title", "class": "monoTitle" },
            { "kind": "md", "field": "content", "class": "centerSub" }
          ]
        }
      ]
    },
    {
      "key": "section",
      "label": "Seksjonsskille",
      "use": "Deler decket i kapitler. Bruk alltid bakgrunnsbilde, og et annet enn tittelsliden.",
      "fields": [
        { "key": "title", "kind": "text", "hint": "seksjonsnavn, 1-2 ord", "required": true },
        { "key": "content", "kind": "text", "hint": "seksjonsnummer med to siffer, f.eks. 01" },
        { "key": "image", "kind": "image", "hint": "bakgrunnsbilde fra temaet", "required": true }
      ],
      "blocks": [
        { "kind": "bg", "field": "image" },
        {
          "kind": "group", "class": "sectionBlock",
          "children": [
            { "kind": "text", "field": "title", "class": "sectionTitle" },
            { "kind": "text", "field": "content", "class": "sectionNum" }
          ]
        }
      ]
    },
    {
      "key": "contents",
      "label": "Innholdsfortegnelse",
      "use": "Oversikt over seksjonene i decket. Nummereringen legges på automatisk.",
      "fields": [
        { "key": "title", "kind": "text", "hint": "overskrift, vanligvis «Innhold»" },
        { "key": "content", "kind": "list", "hint": "én linje per seksjon, som kulepunkter", "required": true }
      ],
      "blocks": [
        { "kind": "brand", "class": "proseMeta" },
        { "kind": "text", "field": "title", "class": "proseLabel", "fallback": "Innhold" },
        { "kind": "toc", "field": "content", "class": "tocList" }
      ]
    },
    {
      "key": "prose",
      "label": "Redaksjonell tekst",
      "use": "Lengre brødtekst i to kolonner, f.eks. introduksjon eller lederens ord.",
      "fields": [
        { "key": "title", "kind": "text", "hint": "seksjonsetikett, 1-2 ord" },
        { "key": "content", "kind": "markdown", "hint": "flere avsnitt brødtekst, kan avsluttes med **Navn** og rolle", "required": true }
      ],
      "blocks": [
        { "kind": "brand", "class": "proseMeta" },
        { "kind": "text", "field": "title", "class": "proseLabel" },
        { "kind": "md", "field": "content", "class": "proseBody" }
      ]
    },
    {
      "key": "text",
      "label": "Løpende tekst",
      "use": "Hovedbudskap i 1-3 korte avsnitt, venstrestilt i stor sans.",
      "fields": [
        { "key": "content", "kind": "markdown", "hint": "1-3 korte avsnitt", "required": true }
      ],
      "blocks": [
        { "kind": "brand", "class": "proseMeta" },
        { "kind": "md", "field": "content", "class": "textBlock" }
      ]
    },
    {
      "key": "statement",
      "label": "Utsagn",
      "use": "Ett stort poeng midt på sliden. Ingen hermetegn, ingen avsender.",
      "fields": [
        { "key": "content", "kind": "text", "hint": "1-3 setninger", "required": true }
      ],
      "blocks": [
        { "kind": "brand", "class": "proseMeta" },
        {
          "kind": "group", "class": "statement",
          "children": [{ "kind": "md", "field": "content", "class": "statementText" }]
        }
      ]
    },
    {
      "key": "quote",
      "label": "Sitat",
      "use": "Sitat med avsender. Hermetegn legges på automatisk.",
      "fields": [
        { "key": "content", "kind": "text", "hint": "selve sitatet, 1-3 setninger, uten hermetegn", "required": true },
        { "key": "title", "kind": "text", "hint": "hvem som sa det" }
      ],
      "blocks": [
        { "kind": "brand", "class": "proseMeta" },
        {
          "kind": "group", "class": "statement",
          "children": [
            { "kind": "quote", "field": "content", "class": "statementText" },
            { "kind": "text", "field": "title", "class": "quoteAuthor", "prefix": "— " }
          ]
        }
      ]
    },
    {
      "key": "bullets",
      "label": "Kulepunkter",
      "use": "3-5 korte punkter under en tittel.",
      "fields": [
        { "key": "title", "kind": "text", "hint": "kort seksjonstittel" },
        { "key": "content", "kind": "list", "hint": "3-5 korte kulepunkter", "required": true }
      ],
      "blocks": [
        { "kind": "text", "field": "title", "class": "heading" },
        { "kind": "md", "field": "content", "class": "bullets" }
      ]
    },
    {
      "key": "image",
      "label": "Bilde med tekst",
      "use": "Ett motiv til høyre, bildetekst til venstre.",
      "fields": [
        { "key": "title", "kind": "text", "hint": "kort bildetittel" },
        { "key": "content", "kind": "markdown", "hint": "1-3 korte caption-linjer" },
        { "key": "image", "kind": "image", "hint": "bilde fra temaet", "required": true }
      ],
      "blocks": [
        { "kind": "brand", "class": "proseMeta" },
        {
          "kind": "group", "class": "imageCaption",
          "children": [
            { "kind": "text", "field": "title", "class": "imageCaptionTitle" },
            { "kind": "md", "field": "content" }
          ]
        },
        { "kind": "image", "field": "image", "class": "imageMain" }
      ]
    },
    {
      "key": "image-lg",
      "label": "Stort bilde",
      "use": "Stort motiv med liten bildetekst.",
      "fields": [
        { "key": "title", "kind": "text", "hint": "kort bildetittel" },
        { "key": "content", "kind": "markdown", "hint": "1-3 korte caption-linjer" },
        { "key": "image", "kind": "image", "hint": "stort motiv fra temaet", "required": true }
      ],
      "blocks": [
        { "kind": "brand", "class": "proseMeta" },
        { "kind": "image", "field": "image", "class": "imageLg" },
        {
          "kind": "group", "class": "imageLgCaption",
          "children": [
            { "kind": "text", "field": "title", "class": "imageCaptionTitle" },
            { "kind": "md", "field": "content" }
          ]
        }
      ]
    },
    {
      "key": "images",
      "label": "To bilder",
      "use": "Ett stort bilde til venstre, ett lite til høyre.",
      "fields": [
        { "key": "title", "kind": "text", "hint": "kort bildetittel" },
        { "key": "content", "kind": "markdown", "hint": "korte caption-linjer for bildene" },
        { "key": "images", "kind": "images", "hint": "to bilder fra temaet: [0] stort venstre, [1] lite høyre", "required": true }
      ],
      "blocks": [
        { "kind": "brand", "class": "proseMeta" },
        { "kind": "imageAt", "field": "images", "index": 0, "class": "imagesBig" },
        { "kind": "imageAt", "field": "images", "index": 1, "class": "imagesSmall" },
        {
          "kind": "group", "class": "imagesCaption",
          "children": [
            { "kind": "text", "field": "title", "class": "imageCaptionTitle" },
            { "kind": "md", "field": "content" }
          ]
        }
      ]
    },
    {
      "key": "figure",
      "label": "Figur med forklaring",
      "use": "Innrammet motiv med forklarende tekst ved siden av.",
      "fields": [
        { "key": "content", "kind": "markdown", "hint": "beskrivelsen ved siden av bildet, 2-4 setninger", "required": true },
        { "key": "title", "kind": "text", "hint": "kort bildetekst eller kilde" },
        { "key": "image", "kind": "image", "hint": "bilde fra temaet", "required": true }
      ],
      "blocks": [
        { "kind": "brand", "class": "proseMeta" },
        { "kind": "image", "field": "image", "class": "figureImg" },
        {
          "kind": "group", "class": "figureText",
          "children": [{ "kind": "md", "field": "content", "class": "statementText" }]
        },
        { "kind": "text", "field": "title", "class": "figureCaption" }
      ]
    },
    {
      "key": "chart",
      "label": "Graf",
      "use": "Én graf med tittel over.",
      "fields": [
        { "key": "title", "kind": "text", "hint": "hva grafen viser, 3-6 ord" },
        { "key": "widget", "kind": "widget", "hint": "bar, line eller donut", "required": true }
      ],
      "blocks": [
        { "kind": "brand", "class": "proseMeta" },
        { "kind": "text", "field": "title", "class": "chartHeading" },
        { "kind": "chart", "field": "widget", "class": "chartArea" }
      ]
    },
    {
      "key": "split",
      "label": "Graf med poeng",
      "use": "Graf til venstre, poenget den underbygger til høyre.",
      "fields": [
        { "key": "content", "kind": "text", "hint": "poenget grafen underbygger, 1-2 setninger", "required": true },
        { "key": "widget", "kind": "widget", "hint": "bar, line eller donut", "required": true }
      ],
      "blocks": [
        { "kind": "chart", "field": "widget", "class": "splitViz" },
        { "kind": "md", "field": "content", "class": "splitText" }
      ]
    },
    {
      "key": "chart-duo",
      "label": "To grafer",
      "use": "To grafer side ved side, hver med egen tittel.",
      "fields": [
        { "key": "title", "kind": "text", "hint": "hva grafene viser" },
        { "key": "widgets", "kind": "widgets", "hint": "nøyaktig to grafer, hver med egen title", "required": true }
      ],
      "blocks": [
        { "kind": "brand", "class": "proseMeta" },
        { "kind": "text", "field": "title", "class": "chartHeading" },
        { "kind": "chartDuo", "field": "widgets" }
      ]
    },
    {
      "key": "kpis",
      "label": "Nøkkeltall",
      "use": "2-4 nøkkeltall på rad. Hver SQL skal gi ett tall.",
      "fields": [
        { "key": "title", "kind": "text", "hint": "kort seksjonstittel" },
        { "key": "widgets", "kind": "widgets", "hint": "2-4 kpi-widgets, hver med title og SQL som gir ett tall", "required": true }
      ],
      "blocks": [
        { "kind": "text", "field": "title", "class": "heading" },
        { "kind": "kpis", "field": "widgets", "class": "kpiRow" }
      ]
    },
    {
      "key": "table",
      "label": "Tabell",
      "use": "Tabell fra databasen under en tittel.",
      "fields": [
        { "key": "title", "kind": "text", "hint": "hva tabellen viser" },
        { "key": "widget", "kind": "widget", "hint": "type table med SELECT", "required": true }
      ],
      "blocks": [
        { "kind": "text", "field": "title", "class": "heading" },
        { "kind": "table", "field": "widget" }
      ]
    }
  ]
}
