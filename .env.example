# OpenAI-kompatibelt EU-endepunkt (Scaleway Generative APIs)
UPSTREAM_BASE_URL=https://api.scaleway.ai/<project-id>/v1
UPSTREAM_API_KEY=<scaleway-secret-key>
PORT=8080
ALLOWED_ORIGIN=http://localhost:5173

# Krev innlogging (default på). Sett false KUN i lokal utvikling.
AUTH_REQUIRED=true

# 32-byte krypteringsnøkkel som 64 hex-tegn. Foretrekkes over secret.key-fila.
# Generer: openssl rand -hex 32
SECRET_KEY=<64-hex-tegn>

# Delt dev-postkasse (MIDLERTIDIG). Kun denne e-posten får bruke /v1/mail/*.
# Tom = mail-funksjonen er av.
MAIL_OWNER_EMAIL=
# Self-hostet SearXNG-søk; tom = DuckDuckGo-fallback (lokal dev uten Docker).
SEARXNG_URL=
# Serper (Googles resultater via API) — omgår IP-blokkeringen datasenter-IP-er møter.
# Tom = av; da brukes SearXNG/DDG som før. Nøkkel fra serper.dev.
SERPER_API_KEY=
